# Do not commit a real .env file. Rotate any token that was shared in chat.
DATABASE_URL=sqlite:///./goddess.db
SESSION_SECRET=replace-with-a-long-random-value
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_API_KEY_1=
GEMINI_API_KEY_1=
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
DISCORD_BOT_TOKEN=
# Default destination when a streamer-specific channel is not configured.
DISCORD_LOG_CHANNEL_ID=
