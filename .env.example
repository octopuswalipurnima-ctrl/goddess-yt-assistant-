# Do not commit a real .env file. Rotate any token that was shared in chat.
DATABASE_URL=sqlite:///./goddess.db
SESSION_SECRET=replace-with-a-long-random-value
SESSION_HTTPS_ONLY=true
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_API_KEY_1=
GEMINI_API_KEY_1=
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# Supplying OPENROUTER_API_KEY enables the fallback automatically. Set false
# only to explicitly disable it.
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DISCORD_BOT_TOKEN=
# Default destination when a streamer-specific channel is not configured.
DISCORD_LOG_CHANNEL_ID=
# Public Railway application URL used by the existing WebSub renewal task.
BASE_URL=https://your-app.up.railway.app
